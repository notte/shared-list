{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev (Server + Client)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}",
        "skipFiles": [
          "<node_internals>/**",
          "**/node_modules/**",
          "**/.next/**",
          "**/@vite/**",
          "**/vite/**",
          "**/*hmr*",
          "**/*runtime*",
          "**/*dev-base*",
          "http://*/**",
          "https://*/**"
        ]
      }
    },
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Chrome: launch client (Pure Frontend)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/.next/**",
        "**/@vite/**",
        "**/*hmr*",
        "**/*runtime*",
        "**/*dev-base*",
        "http://*/**",
        "https://*/**",
        "!${workspaceFolder}/src/**",
        "!${workspaceFolder}/app/**",
        "!${workspaceFolder}/components/**",
        "!${workspaceFolder}/features/**",
        "!${workspaceFolder}/lib/**"
      ]
    },
    {
      "name": "Vitest: current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Vitest: all tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/.next/**",
        "**/@vite/**",
        "**/*hmr*",
        "**/*runtime*",
        "**/*dev-base*"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Next.js: full stack (server + Chrome)",
      "configurations": [
        "Next.js: debug server-side",
        "Chrome: launch client (Pure Frontend)"
      ],
      "stopAll": true
    }
  ]
}
